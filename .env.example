# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
MORLOB_DEPLOYMENT_MODE=self_hosted
MORLOB_APP_DOMAIN=morlob.com
MORLOB_API_DOMAIN=api.morlob.com

# Auth / API
API_KEY_PREFIX=mlb
API_RATE_LIMIT_PER_MINUTE=120

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://uwsqokoloqyfckixfmhb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Legacy Supabase keys are accepted as fallback only.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=

# Storage
MORLOB_STORAGE_BUCKET=morlob-files
MORLOB_MAX_UPLOAD_BYTES=5242880

# MCP
MCP_SERVER_NAME=morlob
MCP_ENDPOINT=/api/mcp

# AWS SES, deferred in P0
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_CONFIGURATION_SET=
AWS_SES_INBOUND_BUCKET=
AWS_SES_INBOUND_TOPIC_ARN=
AWS_SES_FROM_DOMAIN=

# KB / Embeddings, deferred in P0
MORLOB_EMBEDDINGS_PROVIDER=none
MORLOB_EMBEDDINGS_MODEL=
MORLOB_EMBEDDINGS_API_KEY=
